# Google Apps Script Web App URL (see scripts/google-sheets-apps-script.js)
GOOGLE_SHEETS_WEBHOOK_URL=

# Optional shared secret — set the same value as Script Property WEBHOOK_SECRET
GOOGLE_SHEETS_WEBHOOK_SECRET=

# Optional comma-separated hosts for Origin checks (defaults to request Host)
# ALLOWED_HOSTS=lemotor-kaitori.com,www.lemotor-kaitori.com
